# Salin file ini menjadi .env.local untuk development lokal (vercel dev).
# Di Vercel, isi variabel yang sama di Settings > Environment Variables.
# JANGAN pakai prefix VITE_ dan JANGAN commit nilai asli.

GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@nama-project.iam.gserviceaccount.com
# Salin private_key dari file JSON service account. Boleh dengan \n (escaped) dalam satu baris, dibungkus tanda kutip.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_KEY_ANDA\n-----END PRIVATE KEY-----\n"
# ID ada di URL spreadsheet: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=isi_id_spreadsheet
GOOGLE_SHEET_NAME=DATABASE

# Opsional: alternatif gratis Google Apps Script tanpa service-account key.
# Setelah deploy Apps Script sebagai Web App, isi URL deployment di sini:
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/CONTOH/exec
